<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <None Update="_data\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="IronPdf" Version="2024.7.6" />
    <PackageReference Include="OpenCvSharp4.runtime.osx_arm64" Version="4.8.1-rc" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\opencvsharp-main\src\OpenCvSharp\OpenCvSharp.csproj" />
    <ProjectReference
      Include="..\opencvsharp-main\src\OpenCvSharp.Extensions\OpenCvSharp.Extensions.csproj" />
  </ItemGroup>

</Project>